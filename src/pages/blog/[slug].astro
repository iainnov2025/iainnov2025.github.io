---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDateFr } from "../../lib/dates";
import { DISCLAIMER, PILLARS, readingMinutes, relatedPosts } from "../../lib/blog";
import Button from "../../components/Button.astro";
import { site } from "../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const lite = posts.map((p) => ({ id: p.id, pillar: p.data.pillar, date: p.data.date.getTime(), title: p.data.title, description: p.data.description }));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, related: relatedPosts(lite.find((l) => l.id === post.id)!, lite, 3) } }));
}

const { post, related } = Astro.props;
const minutes = readingMinutes(post.body ?? "");
const { Content } = await render(post);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const path = `/blog/${post.id}/`;
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso(post.data.date),
  dateModified: iso(post.data.updated ?? post.data.date),
  author: { "@type": "Organization", name: post.data.author },
  inLanguage: "fr-FR",
  mainEntityOfPage: `${site.siteUrl}${path}`,
  image: `${site.siteUrl}/og/${post.id}.png`,
  articleSection: PILLARS[post.data.pillar],
  keywords: post.data.tags.join(", "),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: `${site.siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${site.siteUrl}/blog/` },
    { "@type": "ListItem", position: 3, name: post.data.title, item: `${site.siteUrl}${path}` },
  ],
};
---
<Base title={post.data.title} description={post.data.description} path={path} ogImage={`/og/${post.id}.png`} jsonLd={[articleLd, breadcrumbLd]}>
  <article class="container post">
    <p class="kicker"><a href="/blog/">Blog</a> · <a href={`/blog/#${post.data.pillar}`}>{PILLARS[post.data.pillar]}</a></p>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.description}</p>
    <p class="meta muted">
      <time datetime={iso(post.data.date)}>{formatDateFr(iso(post.data.date))}</time>
      {post.data.updated && <> · mis à jour le <time datetime={iso(post.data.updated)}>{formatDateFr(iso(post.data.updated))}</time></>}
      · {minutes} min de lecture · Textes vérifiés sur les sites officiels à la date de publication
    </p>
    <div class="body"><Content /></div>
    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources officielles</h2>
      <ul>{post.data.sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}</ul>
    </section>
    <aside class="cta">
      <p class="cta-k">LegalVec</p>
      <p class="cta-t">Chronologie, délais et SWOT de vos dossiers, chaque affirmation reliée à sa pièce.</p>
      <Button href="/dossier-de-demonstration/">Voir le dossier de démonstration</Button>
    </aside>
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">À lire aussi</h2>
        <ul>{related.map((r) => <li><a href={`/blog/${r.id}/`}>{r.title}</a></li>)}</ul>
      </section>
    )}
    <p class="disclaimer muted">{DISCLAIMER}</p>
  </article>
</Base>

<style>
  .post { padding-block: var(--space-8); max-width: 72ch; }
  .post h1 { font-size: var(--step-4); }
  .lede { font-size: var(--step-1); color: var(--color-muted); }
  .body :global(h2) { font-size: var(--step-2); margin-top: var(--space-7); }
  .body :global(blockquote) { margin: var(--space-5) 0; padding: var(--space-3) var(--space-5); border-left: 2px solid var(--color-accent); background: var(--color-surface); font-family: var(--font-serif); font-size: var(--step-1); line-height: 1.5; }
  .body :global(blockquote p) { max-width: none; }
  .body :global(ul) { padding-left: 1.2em; }
  .sources { margin-top: var(--space-7); border-top: 1px solid var(--color-line); padding-top: var(--space-5); }
  .sources h2 { font-size: var(--step-1); font-family: var(--font-sans); font-weight: 600; }
  .meta { font-size: var(--step--1); }
  .cta { margin-top: var(--space-7); padding: var(--space-6); background: var(--color-ink); color: var(--color-paper); border-radius: var(--radius-2); }
  .cta-k { font-size: var(--step--1); letter-spacing: 0.08em; text-transform: uppercase; color: #8FBFB0; margin-bottom: var(--space-2); }
  .cta-t { font-family: var(--font-serif); font-size: var(--step-1); }
  .related { margin-top: var(--space-7); }
  .related h2 { font-size: var(--step-1); font-family: var(--font-sans); font-weight: 600; }
  .related ul { padding-left: 1.2em; display: grid; gap: var(--space-2); }
  .disclaimer { font-size: var(--step--1); margin-top: var(--space-6); }
</style>

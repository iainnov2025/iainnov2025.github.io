---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDateFr } from "../../lib/dates";
import { PILLARS, readingMinutes, type Pillar } from "../../lib/blog";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const iso = (d: Date) => d.toISOString().slice(0, 10);
const groups = (Object.keys(PILLARS) as Pillar[]).map((k) => ({ key: k, label: PILLARS[k], posts: posts.filter((p) => p.data.pillar === k) })).filter((g) => g.posts.length > 0);
---
<Base title="Blog" description="Articles sur le contentieux des affaires et l'usage de l'IA par les avocats, chaque affirmation sourcée par les textes officiels." path="/blog/" ogImage="/og/default.png">
  <div class="container intro">
    <p class="kicker">Blog</p>
    <h1>Notes de contentieux</h1>
    <p class="lede">Des articles courts et sourcés, au plus près des textes officiels. Chaque citation de loi est vérifiée dans sa version en vigueur à la date de publication.</p>
    <nav class="toc" aria-label="Thèmes du blog">{groups.map((g) => <a href={`#${g.key}`}>{g.label}</a>)}</nav>
  </div>
  <div class="container">
    {groups.map((g) => (
      <section class="group" id={g.key} aria-labelledby={`${g.key}-t`}>
        <h2 id={`${g.key}-t`}>{g.label}</h2>
        <ul class="posts">
          {g.posts.map((p) => (
            <li>
              <p class="muted date"><time datetime={iso(p.data.date)}>{formatDateFr(iso(p.data.date))}</time> · {readingMinutes(p.body ?? "")} min</p>
              <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
              <p class="muted">{p.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .intro { padding-block: var(--space-8) var(--space-5); }
  .lede { font-size: var(--step-1); }
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); max-width: 78ch; }
  .posts li { border-top: 1px solid var(--color-line); padding-top: var(--space-5); }
  .toc { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-size: var(--step--1); }
  .group { margin-top: var(--space-7); scroll-margin-top: var(--space-5); }
  .group > h2 { font-size: var(--step-1); font-family: var(--font-sans); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); }
  .posts h3 { font-family: var(--font-serif); font-weight: 500; font-size: var(--step-2); }
  .posts h3 a { color: var(--color-ink); text-decoration: none; }
  .posts h3 a:hover { text-decoration: underline; }
  .date { font-size: var(--step--1); margin-bottom: var(--space-2); }
</style>

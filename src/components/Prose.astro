---
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<article class="container prose">
  <h1>{title}</h1>
  <p class="muted updated">Dernière mise à jour : {updated}</p>
  <slot />
</article>

<style>
  .prose { padding-block: var(--space-8); max-width: 78ch; }
  .prose h1 { font-size: var(--step-4); }
  .prose :global(h2) { font-size: var(--step-2); margin-top: var(--space-7); }
  .prose :global(ul) { padding-left: 1.2em; }
  .updated { font-size: var(--step--1); }
</style>

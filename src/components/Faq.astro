---
/** Accessible FAQ: native <details>, works without JS. */
import type { FaqItem } from "../data/faq";
interface Props { items: FaqItem[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((i) => (
    <details id={`faq-${i.id}`}>
      <summary><span>{i.q}</span><span class="plus" aria-hidden="true"></span></summary>
      <div class="answer">
        {i.a.map((p) => <p>{p}</p>)}
        {i.links && <p class="links">{i.links.map((l) => <a href={l.href}>{l.label}</a>)}</p>}
      </div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--color-line); max-width: 860px; }
  details { border-bottom: 1px solid var(--color-line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding: var(--space-5) 0; font-family: var(--font-serif); font-size: var(--step-1); line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 14px; height: 14px; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; background: var(--color-ink); transition: transform var(--dur-2) var(--ease-out); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  .answer { padding-bottom: var(--space-5); color: var(--color-muted); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-4); }
</style>

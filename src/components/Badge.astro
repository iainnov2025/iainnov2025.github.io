---
interface Props { tone?: "neutral" | "accent" | "warning" | "danger" }
const { tone = "neutral" } = Astro.props;
---
<span class:list={["badge", tone]}><slot /></span>

<style>
  .badge { display: inline-block; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.02em; padding: 0.15em 0.55em; border-radius: 999px; border: 1px solid var(--color-line); color: var(--color-muted); white-space: nowrap; }
  .accent { color: var(--color-accent); border-color: var(--color-accent); }
  .warning { color: var(--color-warning); border-color: var(--color-warning); }
  .danger { color: var(--color-danger); border-color: var(--color-danger); }
</style>

---
/** One per page. Opens the piece referenced by a SourceChip in a native modal dialog. */
---
<dialog id="piece-dialog" aria-labelledby="piece-dialog-title">
  <div class="head">
    <p class="kicker">Pièce source</p>
    <button type="button" class="close" data-close aria-label="Fermer">Fermer</button>
  </div>
  <h2 id="piece-dialog-title" class="mono"></h2>
  <pre class="body"></pre>
</dialog>

<script>
  const dialog = document.getElementById("piece-dialog") as HTMLDialogElement | null;
  let opener: HTMLElement | null = null;
  if (dialog) {
    const title = dialog.querySelector("#piece-dialog-title") as HTMLElement;
    const body = dialog.querySelector(".body") as HTMLElement;
    document.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[data-piece-id]");
      if (!chip) return;
      const item = document.getElementById(`piece-${chip.dataset.pieceId}`);
      if (!item) return; // no target on this page: let the link behave normally
      e.preventDefault();
      opener = chip;
      title.textContent = item.dataset.pieceTitle || chip.dataset.pieceId || "";
      body.textContent = item.querySelector(".piece-text")?.textContent ?? "";
      dialog.showModal();
    });
    dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener("close", () => { opener?.focus(); opener = null; });
  }
</script>

<style>
  dialog { width: min(100% - 2rem, 760px); max-height: 85vh; border: 1px solid var(--color-line); border-radius: var(--radius-2); padding: var(--space-5); background: var(--color-surface); color: var(--color-ink); }
  dialog::backdrop { background: rgba(18, 22, 29, 0.55); }
  .head { display: flex; justify-content: space-between; align-items: center; }
  .close { font: inherit; font-size: var(--step--1); background: none; border: 1px solid var(--color-line); border-radius: var(--radius-1); padding: var(--space-1) var(--space-3); cursor: pointer; }
  h2 { font-size: var(--step-0); overflow-wrap: anywhere; }
  .body { white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.6; margin: 0; }
</style>

---
/**
 * Product dashboard mock-up, built from the curated demo case (no invented numbers).
 * Without JS: overview panel + assistant, fully readable. With JS: sidebar switches panels,
 * the analysis run and the assistant exchange play once, the "action proposée" can be validated.
 * The 3D tilt and floating layers are driven by src/scripts/dashboard.ts only under data-motion="ok".
 */
import type { DemoCase } from "../../data/demo/types";
import { dashboardModel, pieceLabel, pieceKind, shortDate } from "../../lib/dashboard";
import { formatDateFr } from "../../lib/dates";
import SourceChip from "../SourceChip.astro";
import mark from "../../brand/mark.svg?raw";
interface Props { data: DemoCase; floating?: boolean }
const { data, floating = true } = Astro.props;
const m = dashboardModel(data);
const chip = (id: string) => ({ pieceId: id, label: pieceLabel(id) });

const analyses = [
  { name: "Tri des pièces", detail: `${m.counts.pieces} pièces classées` },
  { name: "Chronologie", detail: `${m.counts.events} événements datés` },
  { name: "Délais", detail: `${m.counts.deadlines} échéances` },
  { name: "Parties et demandes", detail: `${data.claims.length} demandes` },
  { name: "SWOT", detail: `${m.counts.swot} points sourcés` },
  { name: "Position", detail: data.position.level },
];
const nextDeadlines = m.deadlines.filter((x) => ["2023-06-27", "2023-08-24", "2023-09-15"].includes(x.dueDate));
const quadrants = [
  { key: "atouts", title: "Atouts" },
  { key: "opportunites", title: "Opportunités" },
  { key: "menaces", title: "Menaces" },
  { key: "failles", title: "Faiblesses" },
] as const;
const nav = [
  { id: "overview", label: "Vue d'ensemble", count: null },
  { id: "timeline", label: "Chronologie", count: m.counts.events },
  { id: "deadlines", label: "Délais", count: m.counts.deadlines },
  { id: "swot", label: "SWOT", count: m.counts.swot },
  { id: "pieces", label: "Pièces", count: m.counts.pieces },
];
---
<div class="stage" data-dashboard>
  <div class="app" data-dash-app role="group" aria-label="Aperçu du tableau de bord LegalVec, dossier de démonstration fictif">
    <aside class="side">
      <div class="side-brand"><span class="mark" set:html={mark} /><span>LegalVec</span></div>
      <p class="side-label">Dossier</p>
      <div class="case-pill">
        <span class="mono">{data.reference}</span>
        <span>GEN-BIO c/ Clinique du Sud</span>
      </div>
      <nav class="side-nav" aria-label="Sections du dossier">
        {nav.map((n, i) => (
          <button type="button" data-dash-tab={n.id} aria-pressed={i === 0 ? "true" : "false"}>
            <span>{n.label}</span>{n.count !== null && <span class="count">{n.count}</span>}
          </button>
        ))}
      </nav>
      <p class="side-foot">Cabinet de démonstration</p>
    </aside>

    <div class="main">
      <header class="main-head">
        <div>
          <p class="crumb">Dossiers / <span class="mono">{data.reference}</span></p>
          <p class="case-title">GEN-BIO c/ Clinique du Sud</p>
          <p class="case-meta">{data.jurisdiction} · Pour le demandeur · Dossier fictif</p>
        </div>
        <div class="head-actions">
          <span class="status" data-dash-status><span class="dot"></span><span data-dash-status-text>Analyse vérifiée</span></span>
          <span class="fake-btn primary">Analyse globale</span>
        </div>
      </header>
      <div class="tabs-m" role="group" aria-label="Sections du dossier">
        {nav.map((n, i) => (
          <button type="button" data-dash-tab={n.id} aria-pressed={i === 0 ? "true" : "false"}>{n.label}</button>
        ))}
      </div>

      <section class="panel" data-dash-panel="overview" aria-label="Vue d'ensemble">
        <div class="kpis">
          <div class="kpi"><p class="k-label">Position</p><p class="k-value warn">{data.position.level}</p></div>
          <div class="kpi"><p class="k-label">Pièces</p><p class="k-value">{m.counts.pieces}</p></div>
          <div class="kpi"><p class="k-label">Événements</p><p class="k-value">{m.counts.events}</p></div>
          <div class="kpi"><p class="k-label">Échéances</p><p class="k-value">{m.counts.deadlines}</p></div>
        </div>
        <div class="grid2">
          <div class="card">
            <p class="card-title">Analyses</p>
            <ul class="runs">
              {analyses.map((a, i) => (
                <li data-dash-run style={`--i:${i}`}>
                  <span class="run-name">{a.name}</span>
                  <span class="run-detail">{a.detail}</span>
                  <span class="bar"><span class="fill"></span></span>
                  <span class="run-state" data-dash-run-state>Vérifiée</span>
                  <span class="fake-btn small">Relancer</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="card">
            <p class="card-title">Échéances</p>
            <ul class="dl">
              {nextDeadlines.map((x) => (
                <li>
                  <span class="dl-date mono">{shortDate(x.dueDate)}</span>
                  <span class="dl-text">{x.description}</span>
                  <SourceChip {...chip(x.sources[0].pieceId)} />
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="card">
          <p class="card-title">Chronologie, faits critiques</p>
          <ol class="strip">
            {m.critical.slice(0, 5).map((e) => (
              <li>
                <span class="s-date mono">{shortDate(e.date)}</span>
                <span class="s-text">{e.title}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="panel" data-dash-panel="timeline" aria-label="Chronologie" hidden>
        <ol class="list">
          {m.events.map((e) => (
            <li class:list={[{ crit: e.importance === "CRITIQUE" }]}>
              <span class="mono l-date">{shortDate(e.date)}</span>
              <span class="l-text">{e.title}</span>
              <span class="l-src">{e.sources.map((s) => <SourceChip {...chip(s.pieceId)} />)}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="panel" data-dash-panel="deadlines" aria-label="Délais" hidden>
        <ol class="list">
          {m.deadlines.map((x) => (
            <li class="crit">
              <span class="mono l-date">{shortDate(x.dueDate)}</span>
              <span class="l-text">{x.description}<span class="l-basis">{x.basis}</span></span>
              <span class="l-src">{x.sources.map((s) => <SourceChip {...chip(s.pieceId)} />)}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="panel" data-dash-panel="swot" aria-label="SWOT" hidden>
        <div class="swot">
          {quadrants.map((q) => (
            <div class="quad">
              <p class="card-title">{q.title}</p>
              {m.swot[q.key].length === 0
                ? <p class="empty">Aucun point sourcé dans les pièces fournies.</p>
                : <ul>{m.swot[q.key].map((i) => <li><span>{i.text}</span> <SourceChip {...chip(i.sources[0].pieceId)} /></li>)}</ul>}
            </div>
          ))}
        </div>
      </section>

      <section class="panel" data-dash-panel="pieces" aria-label="Pièces" hidden>
        <ol class="list">
          {data.pieces.map((p) => (
            <li>
              <span class="mono l-date">{p.date ? shortDate(p.date) : "non datée"}</span>
              <span class="l-text">{pieceKind(p.id)} <span class="l-basis mono">{p.id}</span></span>
              <span class="l-src"><span class="ok">Pertinente</span></span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="chat" aria-label="Assistant du dossier">
      <header class="chat-head"><span>Assistant du dossier</span><span class="tag">Supervisé</span></header>
      <div class="msgs">
        <div class="msg user" data-dash-msg style="--i:0">Sur quoi repose l'accusation de revente hors territoire&nbsp;?</div>
        <div class="msg bot" data-dash-msg style="--i:1">
          <p>Les logs GEN-TRACE font état d'environ 1 247 flacons exportés vers Madrid. <SourceChip {...chip("09_LOGS_EXPORT_GENTRACE_2022_2023")} /></p>
          <p>Attention, la note interne du {formatDateFr("2023-08-02")} indique que ces connexions semblent correspondre à des activités de recherche légitimes. <SourceChip {...chip("24_NOTE_INTERNE_GENBIO_AUDIT_ESPAGNE_20230802")} /></p>
          <p class="verified">Vérifié contre les pièces 09 et 24</p>
        </div>
        <div class="msg action" data-dash-msg data-dash-action style="--i:2">
          <p class="a-label">Action proposée</p>
          <p>Ajouter la tâche «&nbsp;Demander une expertise des logs GEN-TRACE&nbsp;» au dossier.</p>
          <div class="a-btns">
            <button type="button" data-dash-approve>Valider</button>
            <button type="button" data-dash-reject>Refuser</button>
          </div>
          <p class="a-done" data-dash-action-result hidden></p>
        </div>
      </div>
      <div class="composer"><span>Posez une question sur le dossier…</span></div>
    </aside>
  </div>

  {floating && (
    <div class="layers" aria-hidden="true">
      <div class="layer l1"><p class="ly-k">Pièce 07</p><p class="ly-t">Mise en demeure</p><p class="ly-s mono">12/06/2023 · 15 jours</p></div>
      <div class="layer l2"><p class="ly-k">Vérificateur</p><p class="ly-t"><span class="check"></span>Affirmation confirmée</p><p class="ly-s">P. 24 · Note interne</p></div>
    </div>
  )}
</div>

<style>
  .stage { position: relative; --tilt: 0; --mx: 0; --my: 0; perspective: 2200px; perspective-origin: 50% 0%; }
  .app {
    --d-line: #E6E2DA; --d-soft: #F7F5F0; --d-muted: #6A6F77;
    position: relative; display: grid; grid-template-columns: 1fr; background: var(--color-surface); color: var(--color-ink);
    border-radius: 14px; border: 1px solid var(--d-line); overflow: hidden; font-size: 0.82rem; line-height: 1.45;
    box-shadow: 0 1px 0 rgba(18, 22, 29, 0.04), 0 30px 80px -20px rgba(0, 0, 0, 0.45);
    transform-origin: 50% 0%;
  }
  .app p { margin: 0; max-width: none; }
  @media (min-width: 1000px) {
    .app {
      grid-template-columns: 200px 1fr 290px; height: 680px;
      transform: rotateX(calc(var(--tilt) * 24deg + var(--my) * 1.5deg)) rotateY(calc(var(--mx) * 2.5deg)) scale(calc(1 - var(--tilt) * 0.08));
      will-change: transform;
    }
  }

  /* Sidebar */
  .side { display: none; background: var(--d-soft); border-right: 1px solid var(--d-line); padding: 14px 10px; flex-direction: column; gap: 6px; }
  @media (min-width: 1000px) { .side { display: flex; } }
  .side-brand { display: flex; align-items: center; gap: 8px; font-weight: 600; padding: 2px 6px 10px; }
  .mark :global(svg) { width: 20px; height: 20px; display: block; }
  .side-label { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--d-muted); padding: 4px 6px 0; }
  .case-pill { display: grid; gap: 2px; padding: 8px; border: 1px solid var(--d-line); background: var(--color-surface); border-radius: 8px; font-weight: 500; }
  .case-pill .mono { font-size: 0.7rem; color: var(--d-muted); }
  .side-nav { display: grid; gap: 2px; margin-top: 8px; }
  .side-nav button, .tabs-m button {
    display: flex; justify-content: space-between; align-items: center; gap: 8px; width: 100%;
    font: inherit; color: var(--color-ink); background: none; border: 0; border-radius: 6px; padding: 6px 8px; cursor: pointer; text-align: left;
  }
  .side-nav button:hover { background: #EFECE5; }
  .side-nav button[aria-pressed="true"] { background: var(--color-surface); box-shadow: inset 0 0 0 1px var(--d-line); font-weight: 600; }
  .tabs-m { display: flex; gap: 4px; overflow-x: auto; padding: 8px 12px; border-bottom: 1px solid var(--d-line); background: var(--d-soft); }
  .tabs-m button { width: auto; flex: none; white-space: nowrap; }
  .tabs-m button[aria-pressed="true"] { background: var(--color-surface); box-shadow: inset 0 0 0 1px var(--d-line); font-weight: 600; }
  @media (min-width: 1000px) { .tabs-m { display: none; } }
  .count { font-size: 0.7rem; color: var(--d-muted); font-variant-numeric: tabular-nums; }
  .side-foot { margin-top: auto !important; font-size: 0.7rem; color: var(--d-muted); padding: 0 6px; }

  /* Main */
  .main { display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
  .main-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--d-line); }
  .crumb { font-size: 0.7rem; color: var(--d-muted); }
  .case-title { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 500; line-height: 1.2; }
  .case-meta { font-size: 0.72rem; color: var(--d-muted); }
  .head-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .status { display: inline-flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 500; color: var(--color-success); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .fake-btn { display: inline-block; font-size: 0.72rem; font-weight: 500; padding: 5px 10px; border-radius: 6px; border: 1px solid var(--d-line); background: var(--color-surface); white-space: nowrap; }
  .fake-btn.primary { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .fake-btn.small { padding: 2px 7px; font-size: 0.68rem; }
  .panel { padding: 14px 18px; display: grid; gap: 12px; overflow: auto; min-height: 0; flex: 1; align-content: start; }
  .panel[hidden] { display: none; }

  .kpis { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  @media (min-width: 640px) { .kpis { grid-template-columns: repeat(4, 1fr); } }
  .kpi { border: 1px solid var(--d-line); border-radius: 8px; padding: 8px 10px; }
  .k-label { font-size: 0.68rem; color: var(--d-muted); }
  .k-value { font-family: var(--font-serif); font-size: 1.35rem; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .k-value.warn { color: var(--color-warning); }
  .grid2 { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .grid2 { grid-template-columns: 1.15fr 1fr; } }
  .card { border: 1px solid var(--d-line); border-radius: 8px; padding: 10px 12px; min-width: 0; }
  .card-title { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--d-muted); margin-bottom: 8px !important; }

  .runs { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .runs li { display: grid; grid-template-columns: 1fr auto auto; grid-template-areas: "name state btn" "bar bar bar" "detail detail detail"; gap: 2px 8px; align-items: center; }
  .run-name { grid-area: name; font-weight: 500; }
  .run-detail { grid-area: detail; font-size: 0.68rem; color: var(--d-muted); }
  .run-state { grid-area: state; font-size: 0.68rem; font-weight: 600; color: var(--color-success); }
  .runs .fake-btn { grid-area: btn; }
  .bar { grid-area: bar; height: 3px; background: #EEEAE2; border-radius: 3px; overflow: hidden; }
  .fill { display: block; height: 100%; width: 100%; background: var(--color-accent); transform-origin: left; }

  .dl { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .dl li { display: grid; gap: 3px; padding-bottom: 8px; border-bottom: 1px solid var(--d-line); }
  .dl li:last-child { border-bottom: 0; padding-bottom: 0; }
  .dl-date { font-size: 0.72rem; color: var(--color-danger); font-weight: 500; }
  .dl li :global(.chip), .list :global(.chip), .swot :global(.chip), .msg :global(.chip) { font-size: 0.66rem; padding: 0.1em 0.45em; justify-self: start; }

  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 6px; }
  @media (min-width: 640px) { .strip { grid-template-columns: repeat(5, 1fr); position: relative; padding-top: 12px; border-top: 2px solid var(--color-ink); } }
  .strip li { display: grid; gap: 2px; position: relative; }
  @media (min-width: 640px) { .strip li::before { content: ""; position: absolute; top: -17px; left: 0; width: 8px; height: 8px; background: var(--color-accent); } }
  .s-date { font-size: 0.68rem; color: var(--d-muted); }
  .s-text { font-size: 0.74rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: grid; grid-template-columns: 78px 1fr; gap: 4px 12px; padding: 8px 0; border-bottom: 1px solid var(--d-line); }
  .list .l-src { grid-column: 2; display: flex; flex-wrap: wrap; gap: 4px; }
  .list li.crit .l-date { color: var(--color-danger); }
  .l-date { font-size: 0.72rem; color: var(--d-muted); }
  .l-basis { display: block; font-size: 0.68rem; color: var(--d-muted); }
  .ok { font-size: 0.68rem; font-weight: 600; color: var(--color-success); }
  .swot { display: grid; gap: 10px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .swot { grid-template-columns: 1fr 1fr; } }
  .quad { border: 1px solid var(--d-line); border-radius: 8px; padding: 10px 12px; }
  .quad ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .empty { font-size: 0.74rem; color: var(--d-muted); }

  /* Chat */
  .chat { display: flex; flex-direction: column; border-top: 1px solid var(--d-line); background: var(--d-soft); min-width: 0; }
  @media (min-width: 1000px) { .chat { border-top: 0; border-left: 1px solid var(--d-line); } }
  .chat-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; border-bottom: 1px solid var(--d-line); font-weight: 600; }
  .tag { font-size: 0.66rem; font-weight: 600; color: var(--color-accent); border: 1px solid var(--color-accent); border-radius: 999px; padding: 1px 8px; }
  .msgs { flex: 1; display: grid; gap: 10px; align-content: start; padding: 12px; overflow: auto; }
  .msg { border-radius: 10px; padding: 9px 11px; display: grid; gap: 6px; }
  .user { background: var(--color-ink); color: var(--color-paper); justify-self: end; max-width: 88%; }
  .bot { background: var(--color-surface); border: 1px solid var(--d-line); }
  .verified { font-size: 0.68rem; font-weight: 600; color: var(--color-success); }
  .action { background: var(--color-surface); border: 1px solid var(--color-accent); }
  .a-label { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent); }
  .a-btns { display: flex; gap: 6px; }
  .a-btns button { font: inherit; font-size: 0.72rem; font-weight: 500; padding: 4px 10px; border-radius: 6px; cursor: pointer; border: 1px solid var(--d-line); background: var(--color-surface); color: var(--color-ink); }
  .a-btns [data-dash-approve] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); }
  .a-done { font-size: 0.72rem; font-weight: 600; color: var(--color-success); }
  .composer { margin: 0 12px 12px; padding: 9px 11px; border: 1px solid var(--d-line); border-radius: 8px; background: var(--color-surface); color: var(--d-muted); font-size: 0.76rem; }

  /* Floating 3D layers (desktop only) */
  .layers { display: none; }
  @media (min-width: 1000px) {
    .layers { display: block; position: absolute; inset: 0; pointer-events: none; transform-style: preserve-3d; }
    .layer {
      position: absolute; background: var(--color-surface); color: var(--color-ink); border: 1px solid #E6E2DA; border-radius: 10px;
      padding: 10px 14px; box-shadow: 0 24px 50px -18px rgba(0, 0, 0, 0.5); font-size: 0.78rem; min-width: 190px;
    }
    .layer p { margin: 0; }
    .l1 { left: -56px; top: 470px; transform: translate3d(calc(var(--mx) * -14px), calc(var(--tilt) * 60px + var(--my) * -10px), 0) rotate(-2deg); }
    .l2 { right: -48px; top: -64px; transform: translate3d(calc(var(--mx) * 16px), calc(var(--tilt) * 40px + var(--my) * 12px), 0) rotate(1.5deg); }
    .ly-k { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #6A6F77; }
    .ly-t { font-family: var(--font-serif); font-size: 1rem; display: flex; align-items: center; gap: 6px; }
    .ly-s { font-size: 0.7rem; color: #6A6F77; }
    .check { width: 14px; height: 14px; border-radius: 50%; background: var(--color-success); display: inline-block; position: relative; }
    .check::after { content: ""; position: absolute; left: 4.5px; top: 2px; width: 3px; height: 7px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  }

  /* One-shot sequence, only with motion allowed and once the dashboard is in view. */
  :global([data-motion="ok"]) [data-dashboard]:not([data-played="true"]) .fill { transform: scaleX(0); }
  :global([data-motion="ok"]) [data-dashboard]:not([data-played="true"]) [data-dash-msg] { opacity: 0; transform: translateY(6px); }
  :global([data-motion="ok"]) [data-dashboard]:not([data-played="true"]) .layer { opacity: 0; }
  :global([data-motion="ok"]) [data-dashboard][data-played="true"] .fill { transition: transform 900ms var(--ease-out); transition-delay: calc(var(--i, 0) * 260ms); }
  :global([data-motion="ok"]) [data-dashboard][data-played="true"] [data-dash-msg] {
    transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out);
    transition-delay: calc(1800ms + var(--i, 0) * 900ms);
  }
  :global([data-motion="ok"]) [data-dashboard][data-played="true"] .layer { transition: opacity 600ms var(--ease-out) 1200ms; }
</style>

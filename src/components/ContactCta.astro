---
import Button from "./Button.astro";
import { site } from "../config/site";
import { contactHref } from "../lib/contact";
interface Props { subject?: string; label?: string; objet?: "demonstration" | "avis" | "question" | "autre" }
const { subject = "Avis sur LegalVec", label = "Écrire ou réserver un rendez-vous", objet = "avis" } = Astro.props;
// Booking tool or mailbox when configured; otherwise the on-site contact form.
const href = contactHref(site, subject) ?? `/contact/?objet=${objet}`;
---
<span data-contact><Button href={href}>{label}</Button></span>

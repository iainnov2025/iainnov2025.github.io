---
import type { DemoDeadline } from "../../data/demo/types";
import SourceChip from "../SourceChip.astro";
import Badge from "../Badge.astro";
import { formatDateFr } from "../../lib/dates";
interface Props { data: DemoDeadline[]; compact?: boolean; limit?: number }
const { data, compact = false, limit } = Astro.props;
const items = limit ? data.slice(0, limit) : data;
const tone = (u: DemoDeadline["urgency"]) => (u === "CRITIQUE" ? "danger" : u === "IMPORTANT" ? "warning" : "neutral");
const label = (u: DemoDeadline["urgency"]) => (u === "CRITIQUE" ? "Critique" : u === "IMPORTANT" ? "Important" : "Normal");
---
<ul class="deadlines">
  {items.map((x) => (
    <li>
      <div class="when">
        <p class="due">{formatDateFr(x.dueDate)}</p>
        <Badge tone={tone(x.urgency)}>{label(x.urgency)}</Badge>
      </div>
      <div>
        <p class="desc">{x.description}</p>
        {!compact && <p class="basis muted">Fondement : {x.basis}</p>}
        {!compact && <p class="chips">{x.sources.map((s) => <SourceChip pieceId={s.pieceId} />)}</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .deadlines { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  li { display: grid; grid-template-columns: 1fr; gap: var(--space-2) var(--space-5); padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-1); }
  @media (min-width: 720px) { li { grid-template-columns: 11rem 1fr; } }
  .when { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  .due { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .desc { margin: 0 0 var(--space-1); }
  .basis { margin: 0 0 var(--space-2); font-size: var(--step--1); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; }
</style>

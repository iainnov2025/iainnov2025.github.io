---
import type { DemoCase, DemoSwotItem } from "../../data/demo/types";
import SourceChip from "../SourceChip.astro";
import Badge from "../Badge.astro";
interface Props { data: DemoCase["swot"]; compact?: boolean; limit?: number }
const { data, compact = false, limit } = Astro.props;
const quadrants: { key: keyof DemoCase["swot"]; title: string }[] = [
  { key: "atouts", title: "Atouts" },
  { key: "failles", title: "Faiblesses" },
  { key: "opportunites", title: "Opportunités" },
  { key: "menaces", title: "Menaces" },
];
const take = (items: DemoSwotItem[]) => (limit ? items.slice(0, limit) : items);
const tone = (w: DemoSwotItem["weight"]) => (w === "CRITIQUE" ? "accent" : "neutral");
const label = (w: DemoSwotItem["weight"]) => (w === "CRITIQUE" ? "Critique" : w === "IMPORTANT" ? "Important" : "Mineur");
---
<div class:list={["swot", { compact }]}>
  {quadrants.map((q) => (
    <section class="quadrant" aria-label={q.title}>
      {compact ? <p class="qtitle">{q.title}</p> : <h3>{q.title}</h3>}
      <ul>
        {take(data[q.key]).map((i) => (
          <li>
            <p class="text">{i.text}</p>
            {!compact && (
              <p class="meta">
                <Badge tone={tone(i.weight)}>{label(i.weight)}</Badge>
                {i.sources.map((s) => <SourceChip pieceId={s.pieceId} />)}
              </p>
            )}
            {!compact && i.action && <p class="action muted">{i.action}</p>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .swot { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); }
  @media (min-width: 900px) { .swot { grid-template-columns: 1fr 1fr; } }
  .quadrant { background: var(--color-surface); padding: var(--space-5); min-width: 0; }
  h3, .qtitle { font-family: var(--font-serif); font-weight: 500; font-size: var(--step-1); margin: 0 0 var(--space-3); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .text { margin: 0; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-2) 0 0; }
  .action { font-size: var(--step--1); margin: var(--space-2) 0 0; }
  .compact .quadrant { padding: var(--space-4); }
  .compact .text { font-size: var(--step--1); }
</style>

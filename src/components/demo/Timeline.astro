---
import type { DemoEvent } from "../../data/demo/types";
import SourceChip from "../SourceChip.astro";
import Badge from "../Badge.astro";
import { formatDateFr } from "../../lib/dates";
interface Props { data: DemoEvent[]; compact?: boolean; limit?: number }
const { data, compact = false, limit } = Astro.props;
const items = limit ? data.slice(0, limit) : data;
const LABEL: Record<DemoEvent["category"], string> = { FAIT: "Fait", DEPOT: "Acte", AUDIENCE: "Audience", ECHEANCE: "Échéance", DELAI: "Délai" };
---
<ol class:list={["timeline", { compact }]}>
  {items.map((e) => (
    <li class:list={[{ critical: e.importance === "CRITIQUE" }]}>
      <p class="date">{formatDateFr(e.date)}</p>
      <div class="body">
        <p class="title">{e.title}</p>
        {!compact && (
          <p class="meta">
            <Badge tone={e.category === "ECHEANCE" || e.category === "AUDIENCE" ? "warning" : "neutral"}>{LABEL[e.category]}</Badge>
            {e.sources.map((s) => <SourceChip pieceId={s.pieceId} />)}
          </p>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--color-line); }
  li { display: grid; grid-template-columns: 1fr; gap: var(--space-1) var(--space-5); padding: var(--space-4) 0 var(--space-4) var(--space-5); position: relative; }
  li::before { content: ""; position: absolute; left: -4px; top: 1.45rem; width: 7px; height: 7px; background: var(--color-paper); border: 1px solid var(--color-muted); }
  li.critical::before { background: var(--color-accent); border-color: var(--color-accent); }
  @media (min-width: 720px) { li { grid-template-columns: 10rem 1fr; } }
  .date { font-variant-numeric: tabular-nums; color: var(--color-muted); font-size: var(--step--1); margin: 0; padding-top: 0.15rem; }
  .title { margin: 0; font-weight: 500; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin: var(--space-2) 0 0; }
  .compact li { padding-block: var(--space-2); }
  .compact .title { font-size: var(--step--1); }
</style>
